{
  "name": "little-fire-flames",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm run dev:api\" \"npm run dev:frontend\"",
    "dev:api": "npm --prefix api run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "install:all": "npm ci && npm --prefix api ci && npm --prefix frontend ci",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md,html,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,scss,md,html,yml,yaml}\"",
    "build": "npm --prefix api run build && npm --prefix frontend run build",
    "test": "npm --prefix frontend test -- --watch=false",
    "check": "npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sixLUKEY/little-fire-flames.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/sixLUKEY/little-fire-flames/issues"
  },
  "homepage": "https://github.com/sixLUKEY/little-fire-flames#readme",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "dotenv": "^17.2.3",
    "prettier": "^3.2.5"
  }
}
